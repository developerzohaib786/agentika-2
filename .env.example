# Copy to .env on the server. Never commit .env.
DOMAIN=yourname.duckdns.org
DUCKDNS_TOKEN=
GEMINI_API_KEY=
GROQ_API_KEY=
GITHUB_PAT=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
TELEGRAM_BOT_TOKEN=
APP_VERSION=1.0.0

# Backend runs on Alternate Clouds (not on EC2).
# Public URL from `acc services list`: https://<slug>-app.alternatefutures.ai
BACKEND_URL=https://alternate-silent-dust-5778-github-app.alternatefutures.ai
# Shared secret: set on the backend service (acc services env set) and in the Incident MCP.
LOGS_TOKEN=
# Lets the Incident MCP roll back/redeploy the backend via the acc CLI.
AF_TOKEN=
AF_PROJECT_ID=
AF_BACKEND_SERVICE_ID=
# true = rollback/restart only report the acc command. Flip to false once tested.
ACC_DRY_RUN=true

# GitHub repo the backend deploys from (owner/name), for get_deploy_history.
GITHUB_REPO=developerzohaib786/agentika-2
# Subfolder of the backend inside that repo (empty = repo root).
BACKEND_PATH=backend
# Image CI pushes per commit (tag = full sha). Rollback = deploy an older tag.
BACKEND_IMAGE=ghcr.io/developerzohaib786/agentika-backend
# Rollbacks must be this commit or newer (first commit with the backend/ layout).
ROLLBACK_FLOOR_SHA=160cd4dbfa65525b2fc02874da50d1a5c5128734
# n8n: generate once with `openssl rand -hex 24` and never change it (encrypts credentials).
N8N_ENCRYPTION_KEY=
# Required header X-Incident-Token on POST /webhook/incident (also a GitHub Actions secret).
INCIDENT_WEBHOOK_TOKEN=
# Optional bearer token for the Incident MCP endpoint (same value in the n8n MCP credential).
MCP_TOKEN=
TZ=UTC
