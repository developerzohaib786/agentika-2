      "name": "Normalize Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Sentry, curl or anything else: keep one shape for the agents.\nconst b = $input.first().json.body ?? $input.first().json;\nconst id = 'INC-' + new Date().toISOString().replace(/[-:T]/g, '').slice(0, 12);\nreturn [{ json: {\n  id,\n  title: b.title ?? b.message ?? b.event?.title ?? 'Unknown alert',\n  service: b.service ?? b.project ?? 'backend',\n  url: b.url ?? null,\n  source: b.source ?? (b.event ? 'sentry' : 'webhook'),\n  // Set by the CI/CD pipeline (scripts/ci/report-incident.sh):\n  stage: b.stage ?? null,\n  commit: b.commit ?? null,\n  commit_message: b.commit_message ?? null,\n  previous_sha: b.previous_sha ?? null,\n  pushed_by: b.pushed_by ?? null,\n  run_url: b.run_url ?? null,\n  failed_checks: b.failed_checks ?? [],\n  receivedAt: new Date().toISOString(),\n  raw: b,\n} }];"
      }
    },
    {
      "id": "9aeb192d-0786-4d5a-8cf3-4f7f8f318e08",
