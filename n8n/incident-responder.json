      "id": "64e14535-32a9-4e0c-9f79-45424c7fc061",
      "name": "Verify health",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2780,
        300
      ],
      "parameters": {
        "jsCode": "// Alternate Clouds takes the service offline for 1-2 min while it rebuilds,\n// so poll /health for up to ~4 minutes before declaring failure.\nconst rb = $('Rollback (Incident MCP)').first().json;\nconst t = rb.content?.[0]?.text;\nlet result = t;\nif (typeof t === 'string') { try { result = JSON.parse(t); } catch { result = { message: t }; } }\nconst rollbackError = rb.isError || /^Error/.test(String(t ?? '')) ? String(result?.message ?? t) : null;\nconst dryRun = result?.dryRun === true;\n// Nothing was rebuilt: report straight away instead of polling.\nif (rollbackError || dryRun) {\n  return [{ json: { healthy: false, dryRun, rollbackError, rollback: result, checks: [] } }];\n}\nconst url = $env.BACKEND_URL + '/health?format=json';\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\nconst checks = [];\nlet healthy = false;\nawait sleep(30000);\nfor (let i = 0; i < 14 && !healthy; i++) {\n  try {\n    const res = await this.helpers.httpRequest({ url, json: true, returnFullResponse: true, ignoreHttpStatusErrors: true, timeout: 10000 });\n    const b = res.body ?? {};\n    checks.push({ at: new Date().toISOString(), http: res.statusCode, status: b.status, errorRate: b.errorRate });\n    healthy = res.statusCode === 200 && b.status === 'ok';\n  } catch (e) {\n    checks.push({ at: new Date().toISOString(), error: e.message });\n  }\n  if (!healthy) await sleep(15000);\n}\nreturn [{ json: { healthy, dryRun, rollbackError, rollback: result, checks } }];"
      }
    },
